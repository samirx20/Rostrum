// Rostrum: Fender Rhodes Mark II 73 stage piano, one velocity layer, every note E1 to E4 and D6 to E7, recorded from
// the harp through a tube preamp by Tim Kahn (Freesound pack 3957, CC-BY 4.0). F4 to C#6 were never recorded: E4 plays up
// to D#5 and D6 down to E5 (up to 11 half steps of stretch there). Each sample's tuning is corrected to the cent it
// was measured at; the quietest high notes are lifted by half their difference so a line keeps its level.
<global> loop_mode=no_loop amp_veltrack=85 ampeg_release=0.35
<region> sample=notes/E1.ogg pitch_keycenter=28 lokey=28 hikey=28 volume=0.5
<region> sample=notes/F1.ogg pitch_keycenter=29 lokey=29 hikey=29
<region> sample=notes/Fs1.ogg pitch_keycenter=30 lokey=30 hikey=30
<region> sample=notes/G1.ogg pitch_keycenter=31 lokey=31 hikey=31
<region> sample=notes/Gs1.ogg pitch_keycenter=32 lokey=32 hikey=32
<region> sample=notes/A1.ogg pitch_keycenter=33 lokey=33 hikey=33
<region> sample=notes/As1.ogg pitch_keycenter=34 lokey=34 hikey=34
<region> sample=notes/B1.ogg pitch_keycenter=35 lokey=35 hikey=35
<region> sample=notes/C2.ogg pitch_keycenter=36 lokey=36 hikey=36
<region> sample=notes/Cs2.ogg pitch_keycenter=37 lokey=37 hikey=37
<region> sample=notes/D2.ogg pitch_keycenter=38 lokey=38 hikey=38
<region> sample=notes/Ds2.ogg pitch_keycenter=39 lokey=39 hikey=39
<region> sample=notes/E2.ogg pitch_keycenter=40 lokey=40 hikey=40
<region> sample=notes/F2.ogg pitch_keycenter=41 lokey=41 hikey=41
<region> sample=notes/Fs2.ogg pitch_keycenter=42 lokey=42 hikey=42
