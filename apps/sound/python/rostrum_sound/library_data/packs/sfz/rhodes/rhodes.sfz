<region> sample=notes/Gs2.ogg pitch_keycenter=44 lokey=44 hikey=44
<region> sample=notes/A2.ogg pitch_keycenter=45 lokey=45 hikey=45
<region> sample=notes/As2.ogg pitch_keycenter=46 lokey=46 hikey=46
<region> sample=notes/B2.ogg pitch_keycenter=47 lokey=47 hikey=47
<region> sample=notes/C3.ogg pitch_keycenter=48 lokey=48 hikey=48 tune=-3
<region> sample=notes/Cs3.ogg pitch_keycenter=49 lokey=49 hikey=49
<region> sample=notes/D3.ogg pitch_keycenter=50 lokey=50 hikey=50
<region> sample=notes/Ds3.ogg pitch_keycenter=51 lokey=51 hikey=51 tune=-2
<region> sample=notes/E3.ogg pitch_keycenter=52 lokey=52 hikey=52
<region> sample=notes/F3.ogg pitch_keycenter=53 lokey=53 hikey=53 tune=-5
<region> sample=notes/Fs3.ogg pitch_keycenter=54 lokey=54 hikey=54
<region> sample=notes/G3.ogg pitch_keycenter=55 lokey=55 hikey=55
<region> sample=notes/Gs3.ogg pitch_keycenter=56 lokey=56 hikey=56 tune=-6 volume=0.7
<region> sample=notes/A3.ogg pitch_keycenter=57 lokey=57 hikey=57
<region> sample=notes/As3.ogg pitch_keycenter=58 lokey=58 hikey=58 tune=3
<region> sample=notes/B3.ogg pitch_keycenter=59 lokey=59 hikey=59
<region> sample=notes/C4.ogg pitch_keycenter=60 lokey=60 hikey=60 tune=4 volume=0.8
<region> sample=notes/Cs4.ogg pitch_keycenter=61 lokey=61 hikey=61 volume=0.5
<region> sample=notes/D4.ogg pitch_keycenter=62 lokey=62 hikey=62 tune=-4 volume=3.2
<region> sample=notes/Ds4.ogg pitch_keycenter=63 lokey=63 hikey=63 tune=-5 volume=0.6
<region> sample=notes/E4.ogg pitch_keycenter=64 lokey=64 hikey=75 tune=-5 volume=0.3
