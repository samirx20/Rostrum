// Rostrum: Hohner Super 64 harmonica, Accented breath (VCSL, CC0), on every note C3 to C7 (VCSL names them an octave low); the breath-out sound plays when a key lifts (packMaps).
<global> loop_mode=no_loop amp_veltrack=60 ampeg_attack=0.01 ampeg_release=0.12
<region> sample=accented/C2.wav pitch_keycenter=48 lokey=47 hikey=50
<region> sample=accented/E2.wav pitch_keycenter=52 lokey=51 hikey=53
<region> sample=accented/G2.wav pitch_keycenter=55 lokey=54 hikey=57
<region> sample=accented/C3.wav pitch_keycenter=60 lokey=58 hikey=62
<region> sample=accented/E3.wav pitch_keycenter=64 lokey=63 hikey=65
<region> sample=accented/G3.wav pitch_keycenter=67 lokey=66 hikey=69
<region> sample=accented/C4.wav pitch_keycenter=72 lokey=70 hikey=74
<region> sample=accented/E4.wav pitch_keycenter=76 lokey=75 hikey=77
<region> sample=accented/G4.wav pitch_keycenter=79 lokey=78 hikey=81
<region> sample=accented/C5.wav pitch_keycenter=84 lokey=82 hikey=86
<region> sample=accented/E5.wav pitch_keycenter=88 lokey=87 hikey=89
<region> sample=accented/G5.wav pitch_keycenter=91 lokey=90 hikey=93
<region> sample=accented/C6.wav pitch_keycenter=96 lokey=94 hikey=98
<group> trigger=release ampeg_attack=0.005 ampeg_release=0.15 amp_veltrack=0
<region> sample=accented/release_C2.wav pitch_keycenter=48 lokey=47 hikey=50
<region> sample=accented/release_E2.wav pitch_keycenter=52 lokey=51 hikey=53
<region> sample=accented/release_G2.wav pitch_keycenter=55 lokey=54 hikey=57
<region> sample=accented/release_C3.wav pitch_keycenter=60 lokey=58 hikey=62
<region> sample=accented/release_E3.wav pitch_keycenter=64 lokey=63 hikey=65
<region> sample=accented/release_G3.wav pitch_keycenter=67 lokey=66 hikey=69
<region> sample=accented/release_C4.wav pitch_keycenter=72 lokey=70 hikey=74
<region> sample=accented/release_E4.wav pitch_keycenter=76 lokey=75 hikey=77
<region> sample=accented/release_G4.wav pitch_keycenter=79 lokey=78 hikey=81
<region> sample=accented/release_C5.wav pitch_keycenter=84 lokey=82 hikey=86
<region> sample=accented/release_E5.wav pitch_keycenter=88 lokey=87 hikey=89
<region> sample=accented/release_G5.wav pitch_keycenter=91 lokey=90 hikey=93
<region> sample=accented/release_C6.wav pitch_keycenter=96 lokey=94 hikey=98
