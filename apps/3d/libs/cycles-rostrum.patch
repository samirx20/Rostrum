+void HdCyclesSession::SetCastShadows(const bool on)
+{
+  if (on == _castShadows) {
+    return;
+  }
+  const SceneLock lock(this);
+  _castShadows = on;
+  for (const auto &[light, own] : _lightShadows) {
+    light->set_cast_shadow(own && on);
+    if (light->is_modified()) {
+      light->tag_update(lock.scene);
+    }
   }
+  lock.scene->light_manager->tag_update(lock.scene, LightManager::LIGHT_MODIFIED);
 }
 
