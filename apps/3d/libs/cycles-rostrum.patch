+VtVec4fArray HdCyclesInstancer::ComputeInstanceTints(const SdfPath &prototypeId)
+{
+  if (_tint.empty()) {
+    return VtVec4fArray();
+  }
+  HdSceneDelegate *const sceneDelegate = GetDelegate();
+  const HdSceneIndexPrim prim = GetPrim(sceneDelegate, GetId());
+  HdInstancedBySchema instancedBy = HdInstancedBySchema::GetFromParent(prim.dataSource);
+  if (auto pathsDs = instancedBy.GetPaths()) {
+    if (!pathsDs->GetTypedValue(0.0f).empty()) {
+      return VtVec4fArray(); /* nested: the transforms multiply out, a tint per copy has no one place */
+    }
+  }
+  if (!GetParentId().IsEmpty()) {
+    return VtVec4fArray();
+  }
+  HdInstancerTopologySchema topology = HdInstancerTopologySchema::GetFromParent(prim.dataSource);
+  const VtIntArray instanceIndices = topology ?
+                                         topology.ComputeInstanceIndicesForProto(prototypeId) :
+                                         VtIntArray();
+  VtVec4fArray out;
+  out.reserve(instanceIndices.size());
+  for (const int index : instanceIndices) {
+    out.push_back(index < int(_tint.size()) ? _tint[index] : GfVec4f(0.8f, 0.8f, 0.8f, 0.0f));
+  }
+  return out;
+}
