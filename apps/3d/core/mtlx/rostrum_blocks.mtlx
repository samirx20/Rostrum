  <nodedef name="ND_rostrum_colour_adjust_color3" node="rostrum_colour_adjust" nodegroup="rostrum">
    <input name="colour" type="color3" value="0.215861, 0.215861, 0.215861"/>
    <input name="hue" type="float" value="0"/>
    <input name="saturation" type="float" value="1"/>
    <input name="brightness" type="float" value="1"/>
    <input name="contrast" type="float" value="0"/>
    <output name="out" type="color3"/>
  </nodedef>
  <nodegraph name="NG_rostrum_colour_adjust_color3" nodedef="ND_rostrum_colour_adjust_color3">
    <combine3 name="amt" type="vector3"><input name="in1" type="float" interfacename="hue"/><input name="in2" type="float" interfacename="saturation"/><input name="in3" type="float" interfacename="brightness"/></combine3>
    <hsvadjust name="hsv" type="color3"><input name="in" type="color3" interfacename="colour"/><input name="amount" type="vector3" nodename="amt"/></hsvadjust>
    <add name="c" type="float"><input name="in1" type="float" interfacename="contrast"/><input name="in2" type="float" value="1"/></add>
    <contrast name="adj" type="color3"><input name="in" type="color3" nodename="hsv"/><input name="amount" type="float" nodename="c"/><input name="pivot" type="float" value="0.5"/></contrast>
    <output name="out" type="color3" nodename="adj"/>
