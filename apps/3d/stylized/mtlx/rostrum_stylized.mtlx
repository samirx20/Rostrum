<?xml version="1.0"?>
<materialx version="1.39">
  <!-- Rostrum stylized blocks: written by apps/3d/tools/make_blocks_mtlx.py; don't edit. Their values are the material's own fields; the stylized renderer reads those, so these have no implementation -->
  <typedef name="rostrum_style"/>
  <nodedef name="ND_rostrum_lines" node="rostrum_lines" nodegroup="rostrum">
    <input name="linesWidth" type="float" value="1.5"/>
    <input name="linesColor" type="color3" value="0.01033, 0.01033, 0.01033"/>
    <input name="linesTaper" type="float" value="0.5"/>
    <input name="linesWobble" type="float" value="0.3"/>
    <input name="linesCreaseAngle" type="float" value="40"/>
    <input name="then" type="rostrum_style"/>
    <output name="style" type="rostrum_style"/>
  </nodedef>
  <nodedef name="ND_rostrum_light_to_colour" node="rostrum_light_to_colour" nodegroup="rostrum">
    <input name="litColor" type="color3" value="1, 1, 1"/>
    <input name="midColor" type="color3" value="0.450786, 0.450786, 0.450786"/>
    <input name="shadowColor" type="color3" value="0.074214, 0.074214, 0.074214"/>
    <input name="shadowBelow" type="float" value="0.15"/>
    <input name="litFrom" type="float" value="0.5"/>
    <input name="lightEdges" type="string" value="steps" uniform="true"/>
    <input name="lightSoftness" type="float" value="0.1"/>
    <input name="then" type="rostrum_style"/>
    <output name="style" type="rostrum_style"/>
  </nodedef>
  <nodedef name="ND_rostrum_halftone" node="rostrum_halftone" nodegroup="rostrum">
    <input name="halftoneShape" type="string" value="dots" uniform="true"/>
    <input name="halftoneSize" type="float" value="6"/>
    <input name="halftoneAngle" type="float" value="45"/>
    <input name="halftoneColor" type="color3" value="0.01033, 0.01033, 0.01033"/>
    <input name="then" type="rostrum_style"/>
    <output name="style" type="rostrum_style"/>
  </nodedef>
</materialx>
