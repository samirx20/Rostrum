#usda 1.0
(
    doc = "P-3D-3 shot layer: bend the jug for /World/Camera only (squash, lean, swell on that camera's screen)."
)

over "World"
{
    over "Jug"
    {
        string primvars:rostrum:bend:camera = "/World/Camera"
        float primvars:rostrum:bend:squash = 1.12
        float2 primvars:rostrum:bend:lean = (0.22, 0.1)
        float primvars:rostrum:bend:swell = 0.06
        float3 primvars:rostrum:bend:pivot = (-12, 0, -6)
    }
    over "JugHandle"
    {
        string primvars:rostrum:bend:camera = "/World/Camera"
        float primvars:rostrum:bend:squash = 1.12
        float2 primvars:rostrum:bend:lean = (0.22, 0.1)
        float primvars:rostrum:bend:swell = 0.06
        float3 primvars:rostrum:bend:pivot = (-12, 0, -6)
    }
    def Camera "SideCamera"
    {
        float focalLength = 50
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (1, 5000)
        double3 xformOp:translate = (-50, 30, 60)
        float3 xformOp:rotateXYZ = (-14, -40, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
